# Model weights (too large — re-generated by training scripts)
*.safetensors
*.pt
*.bin

# Benchmark generated images and review samples (re-generated, not pushed)
benchmark/generated/
benchmark/samples_for_review/

# Raw dataset sources (provided separately — PDFs, images not tracked)
vector_source/*
!vector_source/README.md
benchmark_data/
train_data/

# Extracted PNG motifs (re-generated by extract_pdf_motifs.py)
vector_extracted/**/*.png

# Crawled supplementary images
wikimedia_raw/images/
wikimedia_raw/thumbnails/
wikimedia_data/images/
wikimedia_data/thumbnails/

# Intermediate checkpoint epoch dirs (large, only final weights matter)
benchmark/checkpoints/**/epoch_*/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Logs
*.log

# Environment
venv/
.env
env/

# OS metadata
.DS_Store
Thumbs.db
._*

# Claude config
.claude/

# Re-run backups and weight file types (local only)
*.ckpt
*.pth
benchmark/checkpoints/*_pre_retrain/
benchmark/checkpoints/M3_crashed_ep10/
benchmark/checkpoints/M6_50ep_unused/
benchmark/checkpoints_v1_leaked/
benchmark/generated_pre_retrain/
benchmark/generated_v1_leaked/
benchmark/_generated_wrong_prompts/
benchmark/results_v1_leaked/
benchmark/_results_wrong_prompts/
generated_samples_v1_leaked/
