# Model weights (too large — re-generated by training scripts)
*.safetensors
*.pt
*.bin

# Benchmark generated images (re-generated by generate_benchmark.py)
benchmark/generated/

# Raw dataset sources (provided separately — PDFs, images not tracked)
vector_source/*
!vector_source/README.md
benchmark_data/
train_data/

# Extracted PNG motifs (re-generated by extract_pdf_motifs.py)
vector_extracted/**/*.png

# Crawled supplementary images
wikimedia_raw/images/
wikimedia_raw/thumbnails/
wikimedia_data/images/
wikimedia_data/thumbnails/

# Intermediate checkpoint epoch dirs (large, only final weights matter)
benchmark/checkpoints/**/epoch_*/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Logs
*.log

# Environment
venv/
.env
env/

# OS metadata
.DS_Store
Thumbs.db
._*

# Claude config
.claude/
